# Required for local development and production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Required for email/password accounts and encrypted Google Drive credentials.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional. If omitted, ENCRYPTION_KEY is also used to sign app sessions.
AUTH_SECRET=replace-with-another-long-random-secret
